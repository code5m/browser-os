{
  "name": "@tauri-browser-tabs/vue",
  "version": "0.1.0",
  "description": "Vue 3 composables and components for tauri-plugin-browser-tabs",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "lint": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tauri-browser-tabs/core": "0.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.4.0"
  },
  "keywords": [
    "tauri",
    "webview",
    "browser",
    "tabs"
  ],
  "homepage": "https://github.com/your-org/tauri-browser-tabs",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/tauri-browser-tabs.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
