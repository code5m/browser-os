{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mvp-browser-os",
  "version": "0.1.0",
  "identifier": "com.jizhijiandan.mvp",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/**",
          "/usr/local/share/**",
          "$HOME/.local/share/**",
          "$HOME/.icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "极智简单 · 浏览器OS融合 MVP",
    "longDescription": "极智简单出品的浏览器与本地工作台融合客户端：多页签浏览、宫格同屏对比、终端、成果库与本地工具箱。",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}