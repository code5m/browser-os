{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mvp-browser-os",
  "version": "0.1.0",
  "identifier": "com.jizhijiandan.mvp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "极智简单 · 浏览器OS融合",
        "width": 1200,
        "height": 800,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
