{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-dev",
  "description": "开发主界面：只允许 main 在固定 Vite 地址使用本地应用权限",
  "local": false,
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:1421/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "browser-tabs:default",
    "default-commands"
  ]
}
