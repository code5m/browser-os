+// M5-W15（Lane A6）：异步视图状态（loading / error / empty / ready）的**纯决策层**。
+//
+// headless 可测（scripts/check-ui-a11y-logic.mjs）。渲染层在
+// src/components/shared/AsyncState.vue。
+
+export type AsyncStateKind = "loading" | "error" | "empty" | "ready";
+
+export interface AsyncViewInput {
+  loading?: boolean;
+  error?: string | null;
+  count?: number;
+}
+
+// 优先级：loading > error > empty > ready。
+export function resolveViewState(input: AsyncViewInput): AsyncStateKind {
+  if (input.loading) return "loading";
+  if (input.error) return "error";
+  if ((input.count ?? 0) <= 0) return "empty";
+  return "ready";
+}
+
+// 每个状态下的 ARIA role / live 区域约定。
+export function ariaForState(
+  state: AsyncStateKind,
+): { role: string; live: "polite" | "assertive" | "off" } {
+  switch (state) {
+    case "loading":
+      return { role: "status", live: "polite" };
+    case "error":
+      return { role: "alert", live: "assertive" };
+    case "empty":
+      return { role: "status", live: "polite" };
+    default:
+      return { role: "group", live: "off" };
+  }
+}
+
+const DEFAULT_LABELS: Record<AsyncStateKind, string> = {
+  loading: "加载中…",
+  error: "加载失败",
+  empty: "暂无数据",
+  ready: "",
+};
+
+export function messageForState(
+  state: AsyncStateKind,
+  labels?: Partial<Record<AsyncStateKind, string>>,
+): string {
+  if (labels && labels[state] != null && labels[state] !== "") return labels[state] as string;
+  return DEFAULT_LABELS[state];
+}
