+// M5-W15（Lane A6）：对话框 / 确认框无障碍焦点决策的**纯函数层**。
+//
+// 与 Vue 渲染解耦，便于 headless 测试（scripts/check-ui-a11y-logic.mjs）。
+// 真正的 DOM 接线在 src/composables/useModalFocus.ts。
+
+export type ModalVariant = "dialog" | "confirm" | "danger" | "alert";
+
+// 可聚焦元素选择器（排除 disabled / 隐藏 tabindex / hidden input）。
+export const FOCUSABLE_SELECTOR = [
+  "a[href]",
+  "button:not([disabled])",
+  'input:not([disabled]):not([type="hidden"])',
+  "select:not([disabled])",
+  "textarea:not([disabled])",
+  '[tabindex]:not([tabindex="-1"])',
+  '[contenteditable="true"]',
+].join(",");
+
+// 确认 / 危险类对话框用 alertdialog（屏幕阅读器会 Announce，并提示用户需显式决策）；
+// 普通信息对话框用 dialog。
+export function ariaRoleForVariant(variant: ModalVariant): "dialog" | "alertdialog" {
+  return variant === "dialog" ? "dialog" : "alertdialog";
+}
+
+// 纯信息 alert（不可取消）不响应 ESC；其余（dialog/confirm/danger）可 ESC 关闭。
+export function shouldCloseOnEscape(variant: ModalVariant): boolean {
+  return variant !== "alert";
+}
+
+// 初始焦点目标选择器：confirm/danger 优先主操作按钮，否则第一个可聚焦元素。
+export function initialFocusSelector(
+  variant: ModalVariant,
+  prefer?: "confirm" | "first" | "container",
+): string {
+  if (prefer === "container") return ".modal,.modal-mask,[tabindex]";
+  if (prefer === "first") return FOCUSABLE_SELECTOR;
+  if (variant === "confirm" || variant === "danger" || prefer === "confirm") {
+    return "button.primary,button.danger,.confirm-btn,[data-modal-primary]," + FOCUSABLE_SELECTOR;
+  }
+  return FOCUSABLE_SELECTOR;
+}
+
+// 焦点循环（Tab / Shift+Tab 在可聚焦列表内回环）。
+export function nextFocusIndex(len: number, current: number): number {
+  if (len <= 0) return 0;
+  if (current < 0) return 0;
+  return (current + 1) % len;
+}
+
+export function prevFocusIndex(len: number, current: number): number {
+  if (len <= 0) return 0;
+  if (current < 0) return len - 1;
+  return (current - 1 + len) % len;
+}
+
+// 给定当前聚焦索引与方向，返回下一焦点索引（供 composable 使用）。
+export function cycleFocus(len: number, current: number, backward: boolean): number {
+  return backward ? prevFocusIndex(len, current) : nextFocusIndex(len, current);
+}
