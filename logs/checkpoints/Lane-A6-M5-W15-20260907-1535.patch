@@ -0,0 +1,107 @@
+#!/usr/bin/env node
+// ---------------------------------------------------------------------------
+// M5-W15（Lane A6）UI 无障碍逻辑层自动化测试（headless，无 GUI 依赖）。
+//
+// 加载**真实** src/utils/modalA11y.ts 与 src/utils/asyncView.ts（纯函数层），
+// 断言焦点决策与异步视图状态的判定——这是 UI 打磨的可测核心。
+// 不重实现逻辑，每条断言反映的都是**产品代码**的行为。
+//
+// 用法: node scripts/check-ui-a11y-logic.mjs
+// 退出码: 0 = 全部通过；1 = 有断言失败
+// ---------------------------------------------------------------------------
+
+import * as nodeModule from "node:module";
+
+function resolveWithExt(specifier, context, next) {
+  try {
+    return next(specifier, context);
+  } catch (err) {
+    if (specifier.startsWith(".") || specifier.startsWith("/")) {
+      for (const ext of [".ts", "/index.ts", ".mjs", ".js"]) {
+        try {
+          return next(specifier + ext, context);
+        } catch {
+          /* try next */
+        }
+      }
+    }
+    throw err;
+  }
+}
+
+if (typeof nodeModule.registerHooks === "function") {
+  nodeModule.registerHooks({ resolve: resolveWithExt });
+} else {
+  nodeModule.register(
+    "data:text/javascript," +
+      encodeURIComponent(
+        `export async function resolve(specifier, context, next) { return globalThis.__uiA11yResolve(specifier, context, next); }`,
+      ),
+  );
+  globalThis.__uiA11yResolve = resolveWithExt;
+}
+
+const a11y = await import("../src/utils/modalA11y.ts");
+const view = await import("../src/utils/asyncView.ts");
+
+let failures = 0;
+function check(name, cond) {
+  if (cond) {
+    console.log("  ok   " + name);
+  } else {
+    console.log("  FAIL " + name);
+    failures++;
+  }
+}
+
+// ---- modalA11y.ts：role / escape / initial-focus / 焦点循环 ----
+
+check("ariaRole dialog -> dialog", a11y.ariaRoleForVariant("dialog") === "dialog");
+check("ariaRole confirm -> alertdialog", a11y.ariaRoleForVariant("confirm") === "alertdialog");
+check("ariaRole danger -> alertdialog", a11y.ariaRoleForVariant("danger") === "alertdialog");
+check("ariaRole alert -> alertdialog", a11y.ariaRoleForVariant("alert") === "alertdialog");
+
+check("escape dialog -> true", a11y.shouldCloseOnEscape("dialog") === true);
+check("escape confirm -> true", a11y.shouldCloseOnEscape("confirm") === true);
+check("escape alert -> false", a11y.shouldCloseOnEscape("alert") === false);
+
+check("initialFocus confirm 优先主按钮", a11y.initialFocusSelector("confirm").startsWith("button.primary"));
+check("initialFocus dialog 取首个可聚焦", a11y.initialFocusSelector("dialog").includes("button"));
+check("initialFocus container 回退容器", a11y.initialFocusSelector("dialog", "container") === ".modal,.modal-mask,[tabindex]");
+
+check("nextFocusIndex 回环", a11y.nextFocusIndex(3, 2) === 0);
+check("nextFocusIndex 起点-1", a11y.nextFocusIndex(3, -1) === 0);
+check("nextFocusIndex 空列表", a11y.nextFocusIndex(0, 0) === 0);
+check("prevFocusIndex 回环", a11y.prevFocusIndex(3, 0) === 2);
+check("prevFocusIndex 起点-1", a11y.prevFocusIndex(3, -1) === 2);
+check("cycleFocus 后退", a11y.cycleFocus(3, 0, true) === 2);
+check("cycleFocus 前进", a11y.cycleFocus(3, 2, false) === 0);
+
+// ---- asyncView.ts：状态解析 / ARIA / 文案 ----
+
+check("state loading 优先", view.resolveViewState({ loading: true, count: 0 }) === "loading");
+check("state error 高于 empty", view.resolveViewState({ error: "x", count: 0 }) === "error");
+check("state empty 当 count=0", view.resolveViewState({ count: 0 }) === "empty");
+check("state ready 当 count>0", view.resolveViewState({ count: 5 }) === "ready");
+
+check(
+  "aria loading = status/polite",
+  view.ariaForState("loading").role === "status" && view.ariaForState("loading").live === "polite",
+);
+check(
+  "aria error = alert/assertive",
+  view.ariaForState("error").role === "alert" && view.ariaForState("error").live === "assertive",
+);
+check("aria empty = status/polite", view.ariaForState("empty").live === "polite");
+check("aria ready = group/off", view.ariaForState("ready").live === "off");
+
+check("message 默认 loading", view.messageForState("loading") === "加载中…");
+check("message 覆盖 empty", view.messageForState("empty", { empty: "无记录" }) === "无记录");
+check("message error 回退原文", view.messageForState("error", { error: "网络异常" }) === "网络异常");
+
+if (failures) {
+  console.log(`UI_A11Y_RESULT=FAIL (${failures})`);
+  process.exit(1);
+}
+console.log("UI_A11Y_RESULT=PASS");
+process.exit(0);
diff --git a/src/components/shared/AsyncState.vue b/src/components/shared/AsyncState.vue
new file mode 100644
index 0000000..36f1cd6
--- /dev/null
+++ b/src/components/shared/AsyncState.vue
@@ -0,0 +1,63 @@
+<script setup lang="ts">
+// M5-W15（Lane A6）：异步视图状态的统一渲染（loading / error / empty / ready）。
+// 纯决策见 src/utils/asyncView.ts；本组件只负责把状态渲染成带正确 ARIA 的占位。
+import { computed } from "vue";
+import { resolveViewState, ariaForState, messageForState, type AsyncStateKind } from "../../utils/asyncView";
+
+const props = withDefaults(
+  defineProps<{
+    loading?: boolean;
+    error?: string | null;
+    count?: number;
+    loadingText?: string;
+    emptyText?: string;
+    errorText?: string;
+  }>(),
+  { loading: false, error: null, count: 0 },
+);
+
+const state = computed<AsyncStateKind>(() =>
+  resolveViewState({ loading: props.loading, error: props.error, count: props.count }),
+);
+const aria = computed(() => ariaForState(state.value));
+const message = computed(() =>
+  messageForState(state.value, {
+    loading: props.loadingText,
+    empty: props.emptyText,
+    error: props.errorText || (props.error ?? undefined),
+  }),
+);
+</script>
+
+<template>
+  <div
+    v-if="state !== 'ready'"
+    :role="aria.role"
+    :aria-live="aria.live"
+    :aria-busy="loading || undefined"
+    class="async-state"
+  >
+    <p v-if="state === 'loading'" class="async-loading">{{ message }}</p>
+    <p v-else-if="state === 'error'" class="async-error">{{ message }}</p>
+    <p v-else class="async-empty">{{ message }}</p>
+  </div>
+  <slot v-else />
+</template>
+
+<style scoped>
+.async-state {
+  padding: 10px 12px;
+}
+.async-loading,
+.async-empty,
+.async-error {
+  margin: 0;
+  font-size: 13px;
+}
+.async-empty {
+  color: #8a8f99;
+}
+.async-error {
+  color: #cf1322;
+}
+</style>
