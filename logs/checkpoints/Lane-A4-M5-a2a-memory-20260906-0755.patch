+## 4. 契约提案
+
+### 4.1 方言抽象（三层）
+
+```rust
+// ---------- 第 1 层：声明/配置（纯类型，落 mvp-core，可序列化） ----------
+
+/// 方言种类（命名对齐 A1 卡 §4.2）。serde 形态固定（`open_ai_compatible` / `external_cli`）。
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum AgentDialect {
+    /// OpenAI 兼容 HTTP API。凭据**不在此结构内**，只以 keyring `agent:<agent_id>` 存。
+    OpenAiCompatible { base_url: String, model: String },
+    /// 外部 CLI Agent（stdio 子进程）。执行**必须**经 script_runner（F-A4-4），不得自起进程。
+    /// 注意（A1 卡 FORBID）：不新增 `TaskKind::AgentDialect`，ExternalCli 落成 Script/Command 片段后走 M2-4。
+    ExternalCli { program: String },
+    // 首期不实现：`McpInproc { endpoint }` —— 见 F-A4-3 与挂账 D-M5-3-5。
+}
+
+/// Agent 声明。**不含任何凭据字段**（F-A4-12）。
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct AgentDef {
+    pub id: String,
+    pub name: String,
+    pub dialect: AgentDialect,
+    pub protocol_version: String,          // 协商用，当前 "1.0"
+    /// 声明的能力；**判定在宿主侧**，此处只是"声称"（A2P taskcard §4.4 第 8 条禁止）。
+    pub declared_capabilities: Vec<String>,
+    pub enabled: bool,                     // 默认 false，与 M4-6 新建任务默认 disabled 同款保守口径
+    pub created_at: DateTime<Utc>,
+}
+```
+
+```rust
+// ---------- 第 2 层：transport trait（实现留在二进制侧，不进 core） ----------
+
+/// 方言适配器的**唯一**对外能力：把一条归一化请求送出去，把归一化响应收回来。
+/// 实现约束（F-A4-4）：
+///   - `ExternalCli` 的实现内部只能调 `script_runner::start_run` / `start_command`；
+///   - `OpenAiCompatible` 的实现必须走 M5-2 `McpGlobalPolicy` 的域名/只读判定；
+///   - 任何实现都**不得**出现 `std::process::Command`。
+pub trait DialectAdapter: Send + Sync {
+    fn kind(&self) -> AgentDialect;
+    fn negotiate(&self, version: &str) -> Result<Negotiated, AgentError>;
+    fn send(&self, env: &AgentRequest) -> Result<AgentResponse, AgentError>;
+    fn cancel(&self, request_id: &str) -> Result<(), AgentError>;
+}
+
+// ---------- 第 3 层：宿主侧统一会话（与方言无关） ----------
+
+pub struct AgentSession {
+    pub session_id: String,
+    pub agent_id: String,
+    pub trace_id: String,
+    pub started_at: DateTime<Utc>,
+    pub last_activity_at: DateTime<Utc>,
+    pub state: AgentSessionState,   // Negotiating | Ready | Busy | Closing | Closed
+}
+```
+
+**归一化的判定顺序（缺一即拒绝，不降级放行）**：
+`agent_id 已登记` → `enabled == true` → `协议版本兼容` → `方言已实现（未登记方言 → -32017）`
+→ `方法所需能力已被 McpGlobalPolicy 授予（F-A4-2）` → `危险能力有本次会话用户显式同意` → 执行。
