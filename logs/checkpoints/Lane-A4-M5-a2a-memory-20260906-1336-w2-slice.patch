+## 5. 精确函数签名（M5-3.a 公开 API）
+
+```rust
+// src-tauri/src/core/agent_kv.rs
+pub enum Namespace { Memory, Facts, Prefs, Session, Draft }
+pub fn validate_namespace(s: &str) -> Option<Namespace>;
+
+pub struct AgentKvStore { /* 三层嵌套 JSON 内存镜像 + 路径 */ }
+pub fn open(path: &Path) -> Result<AgentKvStore, AgentKvError>;
+pub fn flush(store: &AgentKvStore) -> Result<(), AgentKvError>; // atomic_write
+
+pub fn put(
+    store: &mut AgentKvStore,
+    clock: &dyn Clock,
+    audit: &dyn AuditSink,
+    agent_id: &str,
+    ns: Namespace,
+    key: &str,
+    value: serde_json::Value,
+) -> Result<(), AgentKvError>; // 隐私三重闸 + 容量/字节检查 + updated_at
+
+pub fn get(
+    store: &mut AgentKvStore,
+    clock: &dyn Clock,
+    agent_id: &str,
+    ns: Namespace,
+    key: &str,
+) -> Result<Option<serde_json::Value>, AgentKvError>; // 读取刷新 updated_at
+
+pub fn delete(
+    store: &mut AgentKvStore,
+    agent_id: &str,
+    ns: Namespace,
+    key: &str,
+) -> Result<bool, AgentKvError>;
+
+pub fn evict_if_needed(
+    store: &mut AgentKvStore,
+    clock: &dyn Clock,
+    audit: &dyn AuditSink,
+) -> EvictReport; // TTL → per-ns 1000 → per-agent 1MiB → 全局 5MiB/5000，90% 迟滞
+
+pub fn scan_for_secret(value: &serde_json::Value) -> Option<SecretHit>; // 字段名 + 字符串值
+```
+
+错误类型 `AgentKvError`：`SecretRejected(SecretHit)` / `NsForbidden` / `CapacityExceeded` / `AgentCountExceeded` / `Io` / `Json`。
