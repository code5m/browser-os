+export const EDGE_LIMITS = Object.freeze({
+  left: { min: 200, max: 420, default: 260, share: 0.32 },
+  right: { min: 200, max: 420, default: 280, share: 0.32 },
+  bottom: { min: 140, max: 420, default: 240, share: 0.45 },
+});
