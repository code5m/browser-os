+ * state = {
+ *   viewport: { w, h },
+ *   focusMode: boolean,
+ *   topRows: 1 | 2,
+ *   edges: { left:  { visible, primary, size, autoHide }, ... },
+ *   tools:  { [id]: { id, edge, open, pinned, lastSize, autoHide } },
+ *   snapshots: [ { edges, tools, topRows } ],
+ *   focus: { surfaceId, selector },  // last real focus anchor
+ *   focusStack: [ { surfaceId, selector } ],
+ * }
