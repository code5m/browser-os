+  cursor: pointer;
+}
+.hs-btns button:hover {
+  border-color: #2b6cb0;
+  color: #2b6cb0;
+}
+.hs-btns button:focus-visible {
+  outline: 2px solid #2b6cb0;
+  outline-offset: 2px;
+}
+.hs-primary {
+  background: #2b6cb0 !important;
+  border-color: #2b6cb0 !important;
+  color: #fff !important;
+}
+
+@media (max-width: 720px) {
+  .hs-dialog {
