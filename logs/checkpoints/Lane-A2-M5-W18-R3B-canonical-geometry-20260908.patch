+<script>
+(function () {
+  var shell = document.getElementById("shell");
+  var top = document.getElementById("top");
+  var rowA = document.getElementById("rowA");
+  var rowB = document.getElementById("rowB");
+  var statusBar = document.getElementById("status");
+  var rail = document.getElementById("rail");
+  var pLeft = document.getElementById("pLeft");
+  var pRight = document.getElementById("pRight");
+  var pBottom = document.getElementById("pBottom");
+  var content = document.getElementById("content");
+
+  // Tool-window sizing: A2 DESIGN_DECISION (see file header). A0 froze only the
+  // collapsed-state formula, not tool-window widths.
+  function leftW(w) { return Math.min(260, Math.floor(0.25 * w)); }
+  function rightW(w) { return Math.min(320, Math.floor(0.28 * w)); }
+  function bottomH(h) { return Math.min(240, Math.floor(0.30 * h)); }
+
+  var STATES = {
+    // A0 collapsed: every tool window hidden, 28px strip still visible.
+    collapsed: { left: 0, right: 0, bottom: 0, focus: false },
+    left:      { left: 1, right: 0, bottom: 0, focus: false },
+    right:     { left: 0, right: 1, bottom: 0, focus: false },
+    bottom:    { left: 0, right: 0, bottom: 1, focus: false },
+    leftright: { left: 1, right: 1, bottom: 0, focus: false },
+    // Informational only: A0 has NOT frozen focus-mode geometry.
+    focus:     { left: 0, right: 0, bottom: 0, focus: true }
+  };
+
+  function toggle(el, on) { el.classList.toggle("hidden", !on); }
+
+  function measure(w, h, name) {
+    var st = STATES[name];
+    shell.style.width = w + "px";
+    shell.style.height = h + "px";
+
+    toggle(top, !st.focus);
+    toggle(statusBar, !st.focus);
+    toggle(rail, !st.focus);
+    toggle(pLeft, !!st.left);
+    toggle(pRight, !!st.right);
+    toggle(pBottom, !!st.bottom);
+    pLeft.style.width = leftW(w) + "px";
+    pRight.style.width = rightW(w) + "px";
+    pBottom.style.height = bottomH(h) + "px";
+
+    void shell.offsetHeight; // force layout
+
+    var c = content.getBoundingClientRect();
+    return {
+      fixture: "canonical",
+      size: w + "x" + h,
+      w: w,
+      h: h,
+      state: name,
+      topH: +top.getBoundingClientRect().height.toFixed(1),
+      rowAH: +rowA.getBoundingClientRect().height.toFixed(1),
+      rowBH: +rowB.getBoundingClientRect().height.toFixed(1),
+      statusH: +statusBar.getBoundingClientRect().height.toFixed(1),
+      railW: +rail.getBoundingClientRect().width.toFixed(1),
+      leftW: st.left ? leftW(w) : 0,
+      rightW: st.right ? rightW(w) : 0,
+      bottomH: st.bottom ? bottomH(h) : 0,
+      contentH: +c.height.toFixed(1),
+      contentW: +c.width.toFixed(1),
+      pctH: +(c.height / h * 100).toFixed(2),
+      pctW: +(c.width / w * 100).toFixed(2),
+      // >0 means the 30px row had to clip content at this width (no height growth allowed)
+      rowAClip: Math.max(0, rowA.scrollWidth - rowA.clientWidth),
+      rowBClip: Math.max(0, rowB.scrollWidth - rowB.clientWidth)
+    };
+  }
+
+  function sizesFromQuery() {
+    var m = /[?&]sizes=([^&]+)/.exec(location.search || "");
+    if (!m) return [[1440, 900]];
+    return decodeURIComponent(m[1]).split(",").map(function (s) {
+      var p = s.split("x");
+      return [parseInt(p[0], 10), parseInt(p[1], 10)];
+    }).filter(function (p) { return p[0] > 0 && p[1] > 0; });
+  }
+
+  var out = [];
+  sizesFromQuery().forEach(function (s) {
+    Object.keys(STATES).forEach(function (name) {
+      out.push(measure(s[0], s[1], name));
+    });
+  });
+
+  // Leave the page in a human-readable state: canonical 1440x900 collapsed.
+  measure(1440, 900, "collapsed");
+
+  window.__A2_GEOMETRY__ = out;
+  document.getElementById("out").textContent = JSON.stringify(out);
+})();
+</script>
