+    for (var i = 0; i < 5; i++) show(navs[i], i < keep);
+    tbar.classList.remove("nav-compact", "nav-icon");
+    if (w < 900) tbar.classList.add("nav-icon");
+    else if (w < 1180) tbar.classList.add("nav-compact");
+  }
+
+  var STATES = {
+    // 默认静态：无扩展行、无侧栏 —— 用户开机看到的"平静态"
+    calm:    { rows: [],                                  sides: [], view: "browser" },
+    // 地址栏一聚焦就自动展开"最近/常用"（ActivityBar.vue:299）
+    omni:    { rows: ["omni"],                            sides: [], view: "browser" },
+    // ☰ 功能菜单展开
+    more:    { rows: ["more"],                            sides: [], view: "browser" },
+    // 宫格 AI 模式：群发行常驻 + 宫格设置行
+    gridai:  { rows: ["ai", "grid"],                      sides: [], view: "browser" },
+    // 最坏情况：AI 群发 + 宫格设置 + 资源 + 网址 四行同时展开
+    worst:   { rows: ["ai", "grid", "res", "urls"],       sides: [], view: "browser" },
+    // 浏览器右侧 Dock（文件/终端）
+    dock:    { rows: [],                                  sides: ["dock"], view: "browser" },
+    // 左侧 AI 导航 + 收藏夹 + 右侧 Dock 三面同时开
+    sidestack: { rows: [], sides: ["ai", "bm", "dock"],   view: "browser" },
+    // 精简模式：ActivityBar 与页签条都隐藏（App.vue:240 / MainArea.vue:125）
+    compact: { rows: [], sides: [], view: "browser", compact: true },
+    // 模块视图（文件 IDE：固定 260px 树）
+    module:  { rows: [], sides: [], view: "module" }
+  };
+
+  function applyState(name) {
+    var st = STATES[name];
+    q("[data-row]").forEach(function (el) { show(el, st.rows.indexOf(el.getAttribute("data-row")) >= 0); });
+    q("[data-side]").forEach(function (el) { show(el, st.sides.indexOf(el.getAttribute("data-side")) >= 0); });
+    show(tbar, !st.compact);
+    show(tabbar, !st.compact);
+    show(browserview, st.view === "browser");
+    show(modview, st.view === "module");
+  }
+
+  function visibleButtons(root) {
+    return q(root + " button").filter(function (b) { return b.offsetParent !== null; }).length;
+  }
+
+  function measure(w, h, state) {
+    shell.style.width = w + "px";
+    shell.style.height = h + "px";
+    applyDensity(w);
+    applyState(state);
+    void shell.offsetHeight; // force layout
+    var contentEl = STATES[state].view === "module" ? modcontent : viewport;
+    var r = contentEl.getBoundingClientRect();
+    var chrome = h - r.height;
+    return {
+      size: w + "x" + h,
+      state: state,
+      activityH: +activity.getBoundingClientRect().height.toFixed(1),
+      expandH: +(tbar.getBoundingClientRect().height - activity.getBoundingClientRect().height).toFixed(1),
+      tabbarH: STATES[state].compact ? 0 : +tabbar.getBoundingClientRect().height.toFixed(1),
+      statusH: +statusBar.getBoundingClientRect().height.toFixed(1),
+      chromeH: +chrome.toFixed(1),
+      contentH: +r.height.toFixed(1),
+      contentW: +r.width.toFixed(1),
+      pctH: +(r.height / h * 100).toFixed(1),
+      pctW: +(r.width / w * 100).toFixed(1),
+      btnsTop: visibleButtons("#tbar"),
+      btnsTab: STATES[state].compact ? 0 : visibleButtons("#tabbar"),
+      density: w >= 1180 ? "full" : (w >= 900 ? "compact" : "icon")
+    };
+  }
+
+  var SIZES = [
+    [1920, 1080], [1440, 900], [1366, 768], [1024, 720],
+    // 原生标题栏敏感度（假设 37px 系统标题栏，窗口最大化时客户区变矮）
+    [1920, 1043], [1440, 863], [1366, 731], [1024, 683],
+    // 蓝图 WORKBENCH_BLUEPRINT §3 提到的窄窗 800x600；注意产品 min_inner_size=900x600
+    [900, 600], [800, 600]
+  ];
+  var out = [];
+  SIZES.forEach(function (s) {
+    Object.keys(STATES).forEach(function (name) {
+      out.push(measure(s[0], s[1], name));
+    });
+  });
+  document.getElementById("out").textContent = JSON.stringify(out);
+})();
+</script>
+</body>
+</html>
