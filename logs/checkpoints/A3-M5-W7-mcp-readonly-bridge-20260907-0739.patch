+def _extract_fn_body(text: str, start: int) -> str:
+    """从签名起点提取函数体（首个 `{` 起，括号配平到 0）。"""
+    i = text.find("{", start)
+    if i < 0:
+        return ""
+    depth = 0
+    j = i
+    while j < len(text):
+        c = text[j]
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                return text[i + 1 : j]
+        j += 1
+    return text[i + 1 :]
+
