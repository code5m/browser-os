+    invoke<TrustedKeyRecord[]>("plugin_keys_add", {
+      key_id: p.keyId,
+      pubkey: p.pubkey,
+      note: p.note ?? null,
+    }),
+  pluginKeysList: () => invoke<TrustedKeyRecord[]>("plugin_keys_list"),
+  pluginKeysRemove: (keyId: string) =>
+    invoke<TrustedKeyRecord[]>("plugin_keys_remove", { key_id: keyId }),
 };
