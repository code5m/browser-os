+    #[test]
+    fn test_browseros_hygiene_key_fields_and_reinterning() {
+        let db = salsa::DatabaseImpl::new();
+        let edition = Edition::Edition2021;
+        let root = SyntaxContext::root(edition);
+        // SAFETY: These valid IDs are only hashed and compared, never dereferenced.
+        let call = Some(crate::MacroCallId(unsafe { salsa::Id::from_index(1) }));
+        let other_call = Some(crate::MacroCallId(unsafe { salsa::Id::from_index(2) }));
+        let first = SyntaxContext::new(&db, call, Transparency::Opaque, edition, root, None, None);
+        let other_keys = [
+            (other_call, Transparency::Opaque, edition, root),
+            (call, Transparency::SemiOpaque, edition, root),
+            (call, Transparency::Opaque, Edition::Edition2018, root),
+            (call, Transparency::Opaque, edition, first),
+        ];
+        let mut ids = std::collections::HashSet::from([first.into_u32()]);
+        for (call, transparency, edition, parent) in other_keys {
+            let distinct = SyntaxContext::new(&db, call, transparency, edition, parent, None, None);
+            assert!(ids.insert(distinct.into_u32()));
+            let repeated = SyntaxContext::new(
+                &db,
+                call,
+                transparency,
+                edition,
+                parent,
+                Some(root),
+                Some(root),
+            );
+            assert_eq!(repeated, distinct);
+            assert_eq!(repeated.opaque(&db), distinct);
+            assert_eq!(repeated.opaque_and_semiopaque(&db), distinct);
+        }
+        assert_eq!(ids.len(), 5);
+        // SAFETY: This ID was returned by the same live database above.
+        let round_tripped = unsafe { SyntaxContext::from_u32(first.into_u32()) };
+        assert_eq!(round_tripped, first);
+        assert_eq!(round_tripped.parent(&db), root);
+        assert_eq!(round_tripped.edition(&db), edition);
+    }
