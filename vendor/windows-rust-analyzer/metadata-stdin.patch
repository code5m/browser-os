+        assert_eq!(first, borrowed);
+        assert_eq!(borrowed.opaque(&db), first);
+        assert_eq!(borrowed.opaque_and_semiopaque(&db), first);
+
+        // SAFETY: This valid ID is only hashed and compared, never dereferenced.
+        let cold_call = Some(crate::MacroCallId(unsafe { salsa::Id::from_index(2) }));
+        let cold_borrowed = SyntaxContext::new(
+            &db,
+            &cold_call,
+            &transparency,
+            &edition,
+            &root,
+            Some(root),
+            Some(root),
