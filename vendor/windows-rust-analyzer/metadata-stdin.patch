+        let db = salsa::DatabaseImpl::new();
+        let edition = Edition::Edition2021;
+        let root = SyntaxContext::root(edition);
+        // SAFETY: This valid ID is only hashed and compared, never dereferenced.
+        let call = Some(crate::MacroCallId(unsafe { salsa::Id::from_index(1) }));
+        let transparency = Transparency::Opaque;
+        let first = SyntaxContext::new(&db, call, transparency, edition, root, None, None);
+        let borrowed = SyntaxContext::new(
+            &db,
+            &call,
+            &transparency,
+            &edition,
+            &root,
+            Some(root),
+            Some(root),
